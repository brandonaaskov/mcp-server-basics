{
  "tasks": {
    "dev": "deno run --allow-net --allow-read --allow-write --allow-env --allow-ffi --env --watch src/server.ts",
    "start": "deno run --allow-net --allow-read --allow-write --allow-env --allow-ffi --env src/server.ts",
    "test": "deno test --allow-net --allow-read --allow-write --allow-env --allow-ffi --allow-run src/",
    "check": "deno check src/",
    "fmt": "deno fmt src/",
    "lint": "deno lint src/",
    "docker": "docker build --platform linux/amd64 -t mcp-server:latest .",
    "docker-run": "deno task docker && docker run -d --name mcp-server --env-file ./.env -p 8080:8080 mcp-server:latest",
    "verify": "deno task fmt && deno task lint && deno task check && deno task test",
  },
  "imports": {
    "@std/http": "jsr:@std/http@^1.0.0",
    "@std/json": "jsr:@std/json@^1.0.0",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@db/sqlite": "jsr:@db/sqlite@^0.12",
    "ethers": "npm:ethers@^6.8.0"
  },
  "compilerOptions": {
    "lib": ["dom", "deno.ns"],
    "useUnknownInCatchVariables": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "semiColons": false,
    "indentWidth": 2,
    "proseWrap": "preserve"
  }
}
